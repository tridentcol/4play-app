# Expo + pnpm monorepo: hoist transitives that Metro needs to resolve.
# Without this, peers inside .pnpm/ aren't visible from
# apps/mobile/node_modules + monorepoRoot/node_modules.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=nativewind
public-hoist-pattern[]=react-native-css-interop
public-hoist-pattern[]=react-native-svg
public-hoist-pattern[]=react-native-reanimated
public-hoist-pattern[]=react-native-gesture-handler
public-hoist-pattern[]=react-native-safe-area-context
public-hoist-pattern[]=react-native-screens
public-hoist-pattern[]=react-native-worklets
public-hoist-pattern[]=react-native-url-polyfill
