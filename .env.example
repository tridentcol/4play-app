# =====================================================================
# 4 PLAY · Root .env example
# =====================================================================
# Copy this file to .env (gitignored) and fill in real values.
# App-specific .env.local files live in apps/web and apps/mobile and
# may override or extend these values once those apps exist.

# --- Supabase ---------------------------------------------------------
# Project URL and publishable (anon) key are SAFE to ship in clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mobile (Expo) mirrors of the same values
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key — SECRET. Server-only (Edge Functions, webhook).
SUPABASE_SERVICE_ROLE_KEY=

# CLI access token — for non-interactive supabase link / db push / gen types.
# Generate at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Project ref of the linked dev environment (extracted from the project URL)
SUPABASE_PROJECT_REF=

# --- Wompi (Step 11) --------------------------------------------------
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Google Maps / OAuth (Step 6, Step 10) ----------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_WEB=

# --- Observability (Step 14) ------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_KEY=

# --- Email (Step 11) --------------------------------------------------
RESEND_API_KEY=

# --- Web companion URL (used from mobile to open hosted checkout) -----
EXPO_PUBLIC_WEB_URL=https://4play.co
